# ─── Игнорировать всё ──────────────────────────────────────────────
*

# ─── Не игнорировать: core ────────────────────────────────────────
!app/
!app/**
!database/
!database/**
!config.py
!main.py
!CLAUDE.md
!AGENTS.md
!mimo.md
!requirements.txt

# ─── Не игнорировать: tests ───────────────────────────────────────
!tests/
!tests/**

# ─── Не игнорировать: .mimocode, docs ─────────────────────────────
!.mimocode/
!.mimocode/**
!docs/
!docs/**

# ─── Не игнорировать: git/gitignore ───────────────────────────────
!.gitignore

# ─── Всегда игнорировать ──────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.venv/
.env
.idea/
logs/
deploy/
templates/
scripts/
sharx-themes-demo/
